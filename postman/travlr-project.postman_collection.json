{
  "info": {
    "name": "Travlr Final Project: Roles, Trips, Customers and Reservations",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "userEmail",
      "value": "postman@example.test"
    },
    {
      "key": "adminEmail",
      "value": "admin@example.test"
    },
    {
      "key": "adminPassword",
      "value": "MockPassword7!"
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "exec": [
          "if (pm.info.requestName === 'Public collection' || !pm.collectionVariables.get('runEmail')) pm.collectionVariables.set('runEmail', 'postman-' + Date.now() + '@example.test');",
          "pm.variables.set('userEmail', pm.collectionVariables.get('runEmail'));"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Public collection",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/trips",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ]
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Public collection: HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Trip collection is JSON', () => pm.expect(pm.response.json()).to.be.an('array'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Deny anonymous POST",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/trips",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"code\":\"PM007\",\"name\":\"Protected Postman Trip\",\"length\":\"7 days / 6 nights\",\"start\":\"2026-12-12\",\"resort\":\"Gale Reef\",\"perPerson\":899,\"image\":\"reef3.jpg\",\"description\":\"Mock data for authenticated Module Seven testing.\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Deny anonymous POST: HTTP 401', () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    },
