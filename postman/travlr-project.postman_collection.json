        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Login mock user: HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Login returns JWT', () => pm.expect(pm.response.json().token).to.be.a('string'));",
              "pm.collectionVariables.set('token', pm.response.json().token);",
              "const parts = pm.response.json().token.split('.'); parts[2] = (parts[2][0] === 'a' ? 'b' : 'a') + parts[2].slice(1); pm.collectionVariables.set('alteredToken', parts.join('.'));",
              "pm.collectionVariables.set('customerToken', pm.response.json().token);"
            ]
