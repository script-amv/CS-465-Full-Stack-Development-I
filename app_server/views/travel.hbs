{{> header}}
      <div id="contents">
        <div class="box">
          <div>
            <div class="body">
              <h1>Travel</h1>
              <ul id="sites">
                {{#each trips}}
                <li>
                  <a href="/travel"><img src="/images/{{this.image}}" alt="{{this.name}}"></a>
                  <h2><a href="/travel">{{this.name}}</a></h2>
                  <p style="white-space: pre-line">{{this.description}}</p>
                </li>
                {{else}}
                <li><p>No trips are available right now.</p></li>
                {{/each}}
              </ul>
            </div>
          </div>
        </div>
      </div>
{{> footer}}
