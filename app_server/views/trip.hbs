{{> header}}
<div id="contents"><div class="portal-panel">
  <a href="/travel">Back to travel</a>
  <h1>{{trip.name}}</h1>
  <img class="detail-image" src="/images/{{trip.image}}" alt="{{trip.name}}">
  <p>{{trip.location}} · {{trip.resort}}</p>
  <p>{{trip.length}} · Starts {{trip.dateLabel}}</p>
  <p class="trip-price">${{trip.priceLabel}} per person</p>
  <p style="white-space: pre-line">{{trip.description}}</p>
  <form method="get" action="/checkout" class="portal-form compact">
    <input type="hidden" name="tripCode" value="{{trip.code}}">
    <label for="travellers">Number of travellers</label><input type="number" id="travellers" name="travellers" min="1" max="20" value="1" required>
    <button type="submit">Continue to checkout</button>
  </form>
  {{#unless user}}<p>You will be asked to log in before confirming a reservation.</p>{{/unless}}
</div></div>
{{> footer}}
